# Copy to .env and fill in real values. Never commit .env (gitignored).
# All keys from HANDOFF §25; secrets kept empty here.

# App
APP_ENV=development
MAX_VIDEO_DURATION_SEC=15
MAX_VIDEO_SIZE_MB=50
WORKDIR=./data/work

# Speech (faster-whisper)
WHISPER_MODEL_SIZE=tiny

# OCR (PaddleOCR)
OCR_LANG=en

# GPT-5.6 Luna through OpenCode Go
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
LUNA_MODEL=gpt-5.6-luna
LUNA_TIMEOUT_SEC=60

# Local OpenCode research runtime (Investigator Agent)
# Start the headless server with websearch enabled:
#   OPENCODE_ENABLE_EXA=1 OPENCODE_SERVER_PASSWORD=<pw> opencode serve --port 4096
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=

# Google Fact Check
GOOGLE_FACT_CHECK_API_KEY=

# Google Cloud Vision
# GOOGLE_CLOUD_PROJECT is the GCP project ID (a plain string, not a path).
# GOOGLE_APPLICATION_CREDENTIALS is the path to the service-account JSON.
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# SerpAPI Google Lens: vision fallback when Vision is unavailable
# (API key only; no billing account). Get one at https://serpapi.com/.
SERPAPI_API_KEY=

# Feature flags
# ENABLE_URL_INPUT=true is required for direct video URLs (video_url form
# field); file uploads always work.
ENABLE_URL_INPUT=false
# Optional/stretch (not implemented in the MVP): Fact Check image claim
# search requires a publicly accessible imageUri.
ENABLE_FACTCHECK_IMAGE_SEARCH=false
ENABLE_LOCAL_VISUAL_EMBEDDINGS=false
ENABLE_LOCAL_FEATURE_MATCHING=false
